<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OpenTrpg.Systems.Dnd5e.Application\OpenTrpg.Systems.Dnd5e.Application.csproj" />
    <ProjectReference Include="..\..\..\Core\OpenTrpg.Core.Infrastructure\OpenTrpg.Core.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The SRD 5.1 as base content pack (format 3), embedded so it ships inside the assembly and the Docker image. It is
      generated from seed/srd (5e-database, CC-BY 4.0) with tools/SrdPack.
    -->
    <EmbeddedResource Include="../seed/srd-5.1.pack.json" LogicalName="OpenTrpg.Systems.Dnd5e.srd-5.1.pack.json" />
  </ItemGroup>

  <Target Name="EnsureSrdPackEmbedded" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('../seed/srd-5.1.pack.json')"
           Text="The SRD base pack (server/src/Systems/Dnd5e/seed/srd-5.1.pack.json) was not found. Generate it with: dotnet run --project tools/SrdPack (from server/)." />
  </Target>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
