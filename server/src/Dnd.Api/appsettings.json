{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=dnd;Username=dnd;Password=change-me"
  },
  "Database": {
    "AutoMigrate": true
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "UseStartTls": false,
    "Username": "",
    "Password": "",
    "FromAddress": "noreply@example.com",
    "FromName": "D&D Companion"
  },
  "FileStorage": {
    "RootPath": "data/files",
    "MaxUploadMegabytes": 200
  },
  "App": {
    "PublicUrl": "http://localhost:8080",
    "InitialAdminEmail": "admin@example.com",
    "SeedInitialAdmin": true
  },
  "Jwt": {
    "Secret": "dev-only-change-me-this-secret-is-not-for-production-use",
    "Issuer": "dnd-companion",
    "Audience": "dnd-companion-app",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
