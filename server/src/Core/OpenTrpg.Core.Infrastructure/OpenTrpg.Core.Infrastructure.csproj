<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OpenTrpg.Core.Application\OpenTrpg.Core.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.18.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.19.2" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- SRD 5.1 dataset (5e-database), embedded so it ships inside the assembly and the Docker image. -->
    <EmbeddedResource Include="../../../seed/srd/*.json" LinkBase="Seed/Srd" />
  </ItemGroup>

  <Target Name="EnsureSrdDatasetEmbedded" BeforeTargets="BeforeBuild">
    <Error Condition="'@(EmbeddedResource->WithMetadataValue('Extension', '.json')->Count())' == '0'"
           Text="The SRD dataset (server/seed/srd/*.json) was not found. It must be next to src/ when building." />
  </Target>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
