# Copiar a .env y rellenar. .env está en .gitignore: nunca subir valores reales.
# Ninguna variable tiene valor por defecto en docker-compose.yml: todas deben estar aquí.

# Imagen de la API en GitHub Packages: :latest (CI, cada push a master) o :1.2.0 (workflow Release).
API_IMAGE=ghcr.io/example-owner/dnd-companion-api:latest

# Dónde escucha la API en el host. 127.0.0.1 = solo tu reverse proxy local; 0.0.0.0 = toda la LAN/VPN.
API_BIND=127.0.0.1
API_PORT=8080

# Base de datos
POSTGRES_DB=dnd
POSTGRES_USER=dnd
POSTGRES_PASSWORD=change-me
# Aplicar migraciones al arrancar la API
DB_AUTO_MIGRATE=true

# Entorno de ASP.NET Core (Production: logs JSON; Development: logs legibles y más detalle)
ASPNETCORE_ENVIRONMENT=Production

# URL pública con la que los usuarios llegan a la API a través de tu reverse proxy (sin ruta ni barra
# final). Es obligatoria y es la que llevan los enlaces de los correos.
PUBLIC_URL=https://dnd.example.com
# Generar con: openssl rand -base64 48 (mínimo 32 caracteres)
JWT_SECRET=change-me-to-a-long-random-secret
# Zona horaria IANA de las campañas nuevas
DEFAULT_TIME_ZONE=Europe/Madrid

# Correo saliente (tu SMTP). 465 = TLS implícito; 587 = STARTTLS (se detecta por el puerto).
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
# Debe ser una dirección desde la que la cuenta SMTP_USERNAME tenga permiso de enviar
SMTP_FROM_ADDRESS=noreply@example.com
# Comprobar revocación (CRL/OCSP) del certificado del SMTP. false con una CA propia sin CRL publicada;
# la cadena y el nombre del host se validan siempre.
SMTP_CHECK_REVOCATION=false

# CA propia (para un SMTP con certificado privado): fichero PEM del host y ruta donde se monta en el
# contenedor; OpenSSL la carga junto a las CA públicas. Sin CA propia, deja el bundle del sistema.
CA_BUNDLE_HOST_PATH=/etc/ssl/certs/ca-certificates.crt
SSL_CERT_FILE=/certs/ca.pem
