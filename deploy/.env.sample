# Copiar a .env y rellenar. .env está en .gitignore: nunca subir valores reales.
# Ninguna variable tiene valor por defecto en docker-compose.yml: todas deben estar aquí.

# ---- Imagen de la API (GitHub Packages) ----
# :dev-latest y :sha-<commit> los publica la CI en cada push; :1.2.0 y :latest el workflow Release.
API_IMAGE=ghcr.io/example-owner/dnd-companion-api:dev-latest

# ---- Red ----
# Dirección y puerto del host donde escucha la API. 127.0.0.1 = solo tu reverse proxy local;
# 0.0.0.0 = accesible desde la LAN/VPN (proxy en otra máquina o sin proxy).
API_BIND=127.0.0.1
API_PORT=8080
# Dominio(s) admitidos en la cabecera Host (el server_name de tu proxy; varios separados por ;). * = cualquiera.
ALLOWED_HOSTS=dnd.example.com
# Redes (CIDR) desde las que se aceptan las cabeceras X-Forwarded-Proto/Host de tu proxy.
TRUSTED_PROXY_0=127.0.0.1/32
TRUSTED_PROXY_1=172.16.0.0/12
TRUSTED_PROXY_2=192.168.0.0/16
TRUSTED_PROXY_3=10.0.0.0/8
# Respaldo opcional de la URL pública (normalmente vacío: la aporta tu proxy por cabeceras).
PUBLIC_URL=

# ---- Base de datos ----
POSTGRES_DB=dnd
POSTGRES_USER=dnd
POSTGRES_PASSWORD=change-me

# ---- API ----
ADMIN_EMAIL=admin@example.com
# Generar con: openssl rand -base64 48 (mínimo 32 caracteres)
JWT_SECRET=change-me-to-a-long-random-secret
MAX_UPLOAD_MB=200
# Trace, Debug, Information, Warning o Error
LOG_LEVEL=Information
# Zona horaria IANA de las campañas nuevas
DEFAULT_TIME_ZONE=Europe/Madrid
REMINDERS_ENABLED=true
REMINDERS_POLL_SECONDS=60

# ---- Correo (tu SMTP) ----
# 465 = TLS implícito (SslOnConnect); 587 = STARTTLS. Auto lo deduce del puerto.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURITY=Auto
# false solo si tu CA privada no publica CRL/OCSP y el envío falla por revocación
SMTP_CHECK_REVOCATION=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@example.com
SMTP_FROM_NAME="D&D Companion"

# ---- CA propia para el SMTP u otras conexiones TLS salientes ----
# Fichero PEM en el host que se monta en el contenedor y al que apunta SSL_CERT_FILE (OpenSSL lo
# respeta; las CA públicas siguen cargándose del directorio por defecto). Si no tienes CA propia,
# deja el bundle del sistema del host para que el montaje sea válido:
CA_BUNDLE_HOST_PATH=/etc/ssl/certs/ca-certificates.crt
SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt

# ---- Copias de seguridad (backup.sh) ----
BACKUP_RETENTION_DAYS=14
