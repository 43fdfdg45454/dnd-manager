# Copiar a .env y rellenar. .env está en .gitignore: nunca subir valores reales.

# Base de datos
POSTGRES_DB=dnd
POSTGRES_USER=dnd
POSTGRES_PASSWORD=change-me

# API
# Opcional. La URL pública la decide tu reverse proxy (cabeceras X-Forwarded-Proto/Host). Solo se usa
# como respaldo para correos enviados antes de que la API haya recibido una petición por el proxy.
PUBLIC_URL=
# Redes desde las que se aceptan esas cabeceras (CIDR). Por defecto: loopback y redes privadas.
TRUSTED_PROXY_0=127.0.0.1/32
TRUSTED_PROXY_1=172.16.0.0/12
TRUSTED_PROXY_2=192.168.0.0/16
TRUSTED_PROXY_3=10.0.0.0/8
ADMIN_EMAIL=admin@example.com
# Generar con: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret
# Tamaño máximo de subida en MB. Tu reverse proxy debe permitir al menos este tamaño (client_max_body_size en nginx).
MAX_UPLOAD_MB=200
# Nivel mínimo de logs: Trace, Debug, Information, Warning o Error.
# El enlace del administrador inicial se escribe como Warning: no uses Error en el primer arranque.
LOG_LEVEL=Information
# Zona horaria por defecto de las campañas nuevas (IANA) y recordatorios por correo
DEFAULT_TIME_ZONE=Europe/Madrid
REMINDERS_ENABLED=true
REMINDERS_POLL_SECONDS=60

# Correo (SMTP propio). Puerto 465 = TLS implícito (SslOnConnect); 587 = STARTTLS. Auto lo deduce del puerto.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURITY=Auto
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@example.com
SMTP_FROM_NAME="D&D Companion"
# CA propia para el SMTP (u otras conexiones TLS salientes). Monta el fichero en el contenedor
# (ver docker-compose.yml) y apunta aquí. Déjalo vacío para usar solo las CA públicas.
SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt

# Puerto en el que la API escucha en el host. 127.0.0.1 = solo accesible desde el propio host (tu reverse proxy);
# 0.0.0.0 si el proxy está en otra máquina de la LAN/VPN.
API_BIND=127.0.0.1
API_PORT=8080

# Opcional: usar una imagen publicada en lugar de construirla (docker compose pull api).
# API_IMAGE=ghcr.io/example-owner/dnd-companion-api:latest
