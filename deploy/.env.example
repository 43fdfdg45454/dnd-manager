# Copiar a .env y rellenar. .env está en .gitignore: nunca subir valores reales.

# Base de datos
POSTGRES_DB=dnd
POSTGRES_USER=dnd
POSTGRES_PASSWORD=change-me

# API
PUBLIC_URL=https://dnd.example.com
ADMIN_EMAIL=admin@example.com
# Generar con: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret
# Tamaño máximo de subida en MB. Debe coincidir con client_max_body_size de nginx/nginx.conf.
MAX_UPLOAD_MB=200
# Nivel mínimo de logs: Trace, Debug, Information, Warning o Error.
# El enlace del administrador inicial se escribe como Warning: no uses Error en el primer arranque.
LOG_LEVEL=Information
# Zona horaria por defecto de las campañas nuevas (IANA) y recordatorios por correo
DEFAULT_TIME_ZONE=Europe/Madrid
REMINDERS_ENABLED=true
REMINDERS_POLL_SECONDS=60

# Correo (SMTP genérico). Para desarrollo usar el perfil dev con MailHog: host mailhog, puerto 1025.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USE_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@example.com
SMTP_FROM_NAME="D&D Companion"

# Puertos expuestos por nginx
HTTP_PORT=80
HTTPS_PORT=443

# Opcional: usar una imagen publicada en lugar de construirla (docker compose pull api).
# API_IMAGE=ghcr.io/example-owner/dnd-companion-api:latest
# Opcional: nginx sin TLS para LAN/VPN (ver README). Con él, PUBLIC_URL debe empezar por http://
# NGINX_CONF=./nginx/nginx.http.conf
