# Copiar a .env y rellenar. .env está en .gitignore: nunca subir valores reales.

# Base de datos
POSTGRES_DB=dnd
POSTGRES_USER=dnd
POSTGRES_PASSWORD=change-me

# API
PUBLIC_URL=https://dnd.example.com
ADMIN_EMAIL=admin@example.com
# Generar con: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret
MAX_UPLOAD_MB=200

# Correo (SMTP genérico). Para desarrollo usar el perfil dev con MailHog: host mailhog, puerto 1025.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USE_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@example.com
SMTP_FROM_NAME=D&D Companion

# Puertos expuestos por nginx
HTTP_PORT=80
HTTPS_PORT=443
